# Copy to .env.local and fill in with your local `supabase start` output
# (never commit .env.local — it's gitignored). Run `supabase start` from
# the kowabowa-backend repo — this app and that repo share one Supabase
# project, they just live in two codebases.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — defaults to `${NEXT_PUBLIC_SUPABASE_URL}/functions/v1` if unset.
NEXT_PUBLIC_FUNCTIONS_URL=

NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=local
